28,34.488],[34.558,35.048]]},{"key":"revenue#2","text":"Customers buy straight from the brand.","words":[[35.296,36.088],[36.148,36.328],[36.372,36.728],[36.76,36.888],[36.928,37.048],[37.115,37.688]]},{"key":"revenue#3","text":"Amazon · Blinkit · Zepto · Instamart","words":[[38.042,38.728],[38.768,38.808],[38.901,39.528],[39.728,39.928],[39.981,40.408],[40.448,40.488],[40.6,41.368]]},{"key":"revenue#4","text":"Sales through marketplaces and quick commerce","words":[[42.255,42.888],[42.908,43.048],[43.117,43.928],[44.008,44.248],[44.301,44.568],[44.639,45.208]]},{"key":"revenue#5","text":"Customers buy on someone else’s platform, which keeps a share.","words":[[45.648,46.728],[46.788,46.968],[47.048,47.208],[47.248,47.528],[47.576,47.848],[47.91,48.568],[48.608,48.808],[48.848,49.048],[49.088,49.128],[49.195,50.061]]},{"key":"revenue#6","text":"Corporate gifting and bulk orders","words":[[50.648,51.128],[51.168,51.688],[51.728,51.848],[51.928,52.248],[52.328,52.808]]},{"key":"revenue#7","text":"Companies buy many boxes at once.","words":[[53.224,54.088],[54.128,54.248],[54.312,54.568],[54.648,55.048],[55.075,55.128],[55.224,55.768]]},{"key":"revenue#8","text":"These are the four categories revenue is reported by. No split between them is published in this chapter.","words":[[56.061,56.728],[56.768,56.888],[56.928,57.048],[57.096,57.288],[57.353,58.008],[58.078,58.568],[58.621,58.728],[58.79,59.288],[59.368,60.488],[60.568,60.728],[60.795,61.128],[61.178,61.528],[61.576,61.768],[61.821,61.928],[61.984,62.488],[62.541,62.648],[62.68,62.808],[62.858,63.288]]},{"key":"revenue#9","text":"In plain words A revenue stream is one way of earning. Looking at revenue by channel and by category shows which parts of the business bring in the most.","words":[[63.901,64.648],[64.715,65.048],[65.128,65.528],[65.728,65.928],[65.988,66.408],[66.488,66.968],[67.021,67.128],[67.208,67.448],[67.528,67.768],[67.821,67.928],[67.978,68.928],[69.003,69.528],[69.555,69.608],[69.668,70.088],[70.141,70.248],[70.318,70.808],[70.848,70.968],[71.021,71.128],[71.199,71.768],[71.888,72.488],[72.528,72.728],[72.795,73.128],[73.155,73.208],[73.228,73.288],[73.341,73.768],[73.821,74.088],[74.141,74.248],[74.268,74.328],[74.408,74.808]]},{"key":"revenue#explain","text":"In simple words: Revenue streams are the ways money comes in, like sales on the brand's website, on marketplaces and quick commerce apps, and corporate gifting orders.","words":[[75.915,75.928],[75.985,76.328],[76.421,76.968],[77.048,77.608],[77.678,78.168],[78.208,78.328],[78.348,78.408],[78.488,78.808],[78.861,79.128],[79.195,79.528],[79.608,80.048],[80.104,80.328],[80.395,80.728],[80.755,80.808],[80.848,80.968],[81.008,81.288],[81.358,81.928],[82.088,82.408],[82.465,83.208],[83.308,83.608],[83.661,83.928],[83.981,84.408],[84.472,85.128],[85.148,85.208],[85.256,85.688],[85.728,86.088],[86.157,87.048]]},{"key":"costs#0","text":"Where the money goes","words":[[87.608,88.008],[88.048,88.168],[88.208,88.408],[88.52,88.968]]},{"key":"costs#1","text":"1 Ingredients and production","words":[[89.928,90.408],[90.501,91.528],[91.568,91.688],[91.739,92.248]]},{"key":"costs#2","text":"2 Packaging","words":[[93.208,93.528],[93.632,94.568]]},{"key":"costs#3","text":"3 Logistics and delivery","words":[[95.448,95.848],[95.952,96.888],[96.948,97.128],[97.199,97.768]]},{"key":"costs#4","text":"4 Marketing and platform commissions","words":[[98.808,99.128],[99.224,100.088],[100.148,100.328],[100.39,100.888],[100.941,101.528]]},{"key":"costs#5","text":"5 Team, kitchen and operating costs","words":[[102.408,102.888],[103.048,104.048],[104.093,104.408],[104.488,104.728],[104.776,105.208],[105.315,105.848]]},{"key":"costs#6","text":"In plain words Every order carries these costs. Some are paid per order (ingredients, packaging, delivery, commission ). Others, like the team and the kitchen, are paid whether or not an order comes in.","words":[[106.461,107.208],[107.275,107.608],[107.688,108.088],[108.208,108.808],[108.875,109.208],[109.268,109.688],[109.728,109.928],[110.035,110.808],[110.936,111.448],[111.488,111.608],[111.672,111.928],[111.988,112.168],[112.235,112.568],[112.808,113.928],[113.976,114.648],[114.701,115.368],[115.426,116.008],[116.035,116.088],[116.259,117.368],[117.416,117.608],[117.628,117.688],[117.784,118.168],[118.208,118.328],[118.348,118.408],[118.458,119.208],[119.248,119.368],[119.448,119.768],[119.808,120.088],[120.115,120.168],[120.228,120.408],[120.461,120.568],[120.621,120.888],[120.941,121.208],[121.288,121.528]]},{"key":"costs#explain","text":"Think of it like this: The cost structure is where money goes out: ingredients, packaging, logistics, marketing, and the team and kitchen.","words":[[122.479,122.812],[122.839,122.892],[122.945,123.052],[123.1,123.292],[123.372,123.772],[123.932,124.412],[124.508,124.892],[124.94,125.372],[125.452,125.612],[125.652,125.852],[125.919,126.252],[126.316,126.572],[126.652,127.532],[127.592,128.492],[128.548,129.292],[129.356,130.332],[130.38,131.132],[131.152,131.212],[131.252,131.372],[131.468,131.852],[131.912,132.092],[132.142,132.572]]},{"key":"profit#0","text":"Growing fast, losses narrowing","words":[[132.902,134.092],[134.204,134.652],[134.755,135.372],[135.428,135.932]]},{"key":"profit#1","text":"up about 171.5% in FY24, 63% in FY25","words":[[136.359,136.732],[136.785,137.052],[137.132,139.692],[139.745,139.852],[140.012,141.612],[141.692,142.652],[142.705,142.812],[143.025,144.092]]},{"key":"profit#2","text":"About 46.6% smaller than the Rs 1.18 crore lost in FY23: revenue Rs 14.47 crore, total expenses Rs 15.30 crore, net margin −4.3%.","words":[[144.425,145.292],[145.452,147.052],[147.122,147.612],[147.708,148.092],[148.112,148.172],[148.199,148.252],[148.412,149.452],[149.505,149.772],[149.948,150.652],[150.732,150.892],[151.052,152.732],[152.822,153.452],[153.505,153.612],[153.692,155.132],[155.199,156.012],[156.092,156.492],[156.572,157.212],[157.292,157.452],[157.812,158.972],[159.052,159.892],[160.002,160.332],[160.401,160.812],[161.172,162.812]]},{"key":"profit#3","text":"Revenue grew from Rs 67 lakh in FY22 to Rs 5.33 crore in FY23 , Rs 14.47 crore in FY24 and Rs 23.90 crore in FY25 (reported growth 63%): about 35 times in three years. In FY24 the business spent Rs 15.30 crore against Rs 14.47 crore of revenue, a net loss of Rs 62.96 lakh. That loss was about 46.6% smaller than the Rs 1.18 crore lost in FY23.","words":[[163.062,164.252],[164.332,164.652],[164.7,164.892],[164.945,165.052],[165.372,165.692],[165.74,165.932],[166.145,166.572],[166.759,167.852],[168.012,168.332],[168.385,168.492],[168.692,169.772],[169.825,170.092],[170.332,170.812],[170.999,172.012],[172.452,172.892],[172.919,172.972],[173.412,174.492],[174.532,174.732],[174.945,175.372],[175.559,176.652],[176.812,177.292],[177.319,177.372],[177.373,179.052],[179.105,179.372],[179.612,180.092],[180.279,181.372],[181.732,182.492],[182.561,182.972],[183.212,184.572],[184.612,184.812],[185.052,185.612],[185.679,186.012],[186.092,186.252],[186.292,186.492],[186.572,187.212],[187.559,188.252],[188.439,189.532],[189.612,189.852],[189.896,190.252],[190.319,190.652],[190.665,190.692],[190.732,192.412],[192.452,192.652],[192.802,193.852],[193.879,193.932],[194.212,195.452],[195.505,195.772],[195.959,196.332],[196.392,197.452],[197.532,197.612],[197.672,197.852],[197.948,198.332],[198.385,198.492],[198.519,198.572],[198.652,200.332],[200.396,201.212],[201.436,202.332],[202.412,202.732],[202.792,202.972],[203.025,203.292],[203.452,205.052],[205.122,205.612],[205.724,206.172],[206.212,206.332],[206.368,206.439],[206.545,207.532],[207.599,207.932],[208.108,208.812],[208.892,209.052],[209.239,210.372]]},{"key":"profit#4","text":"the cost of making it and of delivering it","words":[[210.732,211.452],[211.548,211.932],[211.959,212.012],[212.069,212.412],[212.465,212.572],[212.652,212.892],[212.945,213.052],[213.088,213.452],[213.532,213.692]]},{"key":"profit#5","text":"In plain words Unit economics means looking at what one order earns after the cost of making and delivering it.","words":[[214.199,214.892],[214.945,215.212],[215.292,215.692],[215.82,216.332],[216.404,217.052],[217.105,217.372],[217.412,217.692],[217.745,217.852],[217.9,218.092],[218.192,218.492],[218.559,218.892],[218.985,219.452],[219.559,220.092],[220.132,220.252],[220.332,220.652],[220.705,220.812],[220.869,221.212],[221.292,221.532],[221.576,222.012],[222.065,222.252]]},{"key":"profit#explain","text":"So what does that mean? Profit is what is left when money in is bigger than money out. Eat Better's sales grew fast, from sixty seven lakh rupees in FY22 to about twenty four crore rupees in FY25. In FY24 it still spent a little more than it earned, a loss of about sixty three lakh rupees, but that loss was almost half the year before.","words":[[223.265,223.372],[223.42,223.612],[223.66,223.852],[223.9,224.092],[224.172,225.052],[225.132,225.612],[225.665,225.772],[225.82,226.012],[226.065,226.172],[226.236,226.492],[226.54,226.732],[226.785,227.052],[227.185,227.452],[227.532,227.692],[227.738,228.012],[228.06,228.252],[228.292,228.492],[228.572,228.812],[229.072,229.852],[229.909,230.332],[230.399,230.732],[230.78,230.972],[231.084,231.772],[231.82,232.012],[232.079,232.412],[232.465,232.732],[232.812,233.132],[233.212,233.612],[233.692,233.852],[234.039,235.132],[235.319,235.692],[235.745,236.012],[236.069,236.412],[236.46,236.652],[236.745,237.212],[237.292,237.772],[237.852,238.012],[238.199,239.292],[239.665,240.412],[240.625,241.692],[241.852,242.172],[242.225,242.492],[242.545,242.812],[242.892,242.972],[243.006,243.212],[243.26,243.452],[243.484,243.612],[243.639,243.692],[243.749,244.492],[244.532,244.572],[244.652,244.972],[245.025,245.132],[245.185,245.452],[245.519,245.852],[245.892,246.092],[246.188,246.572],[246.625,247.132],[247.312,247.852],[247.9,248.092],[248.172,248.492],[248.552,248.732],[248.789,249.132],[249.196,249.452],[249.492,249.612],[249.66,249.852],[249.921,250.412]]},{"key":"think#0","text":"Your turn to think","words":[[250.748,251.452],[251.516,251.772],[251.799,251.852],[251.919,252.252]]},{"key":"think#1","text":"1. Why might a quick-commerce sale earn less per pack than a website sale?","words":[[253.212,253.612],[253.792,254.332],[254.372,254.572],[254.612,254.652],[254.705,255.452],[255.532,255.852],[255.916,256.172],[256.236,256.492],[256.532,256.652],[256.732,257.052],[257.1,257.292],[257.332,257.372],[257.432,257.852],[257.932,258.692]]},{"key":"think#explain","text":"Let me explain: Remember: growth and profit are different things. A brand can grow fast and still be working towards profitability.","words":[[259.357,259.372],[259.425,259.532],[259.612,260.772],[260.839,261.812],[261.875,262.252],[262.292,262.412],[262.481,262.892],[262.952,263.132],[263.172,263.532],[263.589,264.012],[264.412,264.812],[264.879,265.212],[265.252,265.372],[265.436,265.692],[265.82,266.332],[266.392,266.572],[266.625,266.892],[266.945,267.052],[267.092,267.372],[267.432,267.852],[267.909,269.052]]},{"key":"activities#0","text":"Put it into practice","words":[[269.552,269.852],[269.905,270.012],[270.044,270.172],[270.243,270.812]]},{"key":"activities#1","text":"Three number-driven tasks. Each one only moves forward when your working is right, and every practice number changes each time you start.","words":[[271.465,271.932],[271.989,272.652],[272.759,273.372],[273.532,274.172],[274.252,274.492],[274.572,274.892],[274.945,275.212],[275.272,275.692],[275.756,276.012],[276.044,276.172],[276.222,276.572],[276.599,276.652],[276.719,277.612],[277.672,277.852],[277.919,278.252],[278.305,278.732],[278.778,279.052],[279.122,279.612],[279.692,280.012],[280.076,280.332],[280.352,280.412],[280.479,280.892]]},{"key":"outro","text":"And that's the whole chapter! You listened all the way through. Great job!","words":[[282.032,282.092],[282.156,282.572],[282.592,282.652],[282.705,282.972],[283.032,283.532],[283.712,284.252],[284.296,284.652],[284.692,284.81