6],[2.926,2.966],[3.019,3.286],[3.353,3.686],[3.713,3.766],[3.806,3.846],[3.899,4.406],[4.47,5.206],[5.326,5.686],[5.755,6.166],[6.23,6.486],[6.513,6.566],[6.626,6.806],[6.856,7.206],[7.253,7.766],[7.833,8.326],[8.406,8.886],[8.966,9.206],[9.259,9.686],[9.75,10.006],[10.063,10.406],[10.433,10.486],[10.543,11.686],[11.748,12.246],[12.315,12.726],[12.806,13.126],[13.166,13.206],[13.24,13.926],[13.988,14.606]]},{"key":"audience#0","text":"Who Eat Better is for","words":[[14.946,15.606],[15.666,15.846],[15.903,16.246],[16.406,16.726],[16.826,17.126]]},{"key":"audience#1","text":"A target audience is the specific group of people a brand wants to reach because its products meet their needs, preferences, or buying motivations .","words":[[17.606,17.766],[17.823,18.166],[18.219,18.646],[18.726,18.886],[18.906,18.966],[19.028,19.526],[19.566,19.766],[19.793,19.846],[19.903,20.246],[20.326,20.406],[20.459,20.726],[20.766,20.966],[21.019,21.126],[21.193,21.526],[21.576,21.926],[21.966,22.086],[22.139,22.566],[22.598,22.726],[22.766,22.966],[23.033,23.606],[23.659,24.406],[24.459,24.566],[24.612,24.886],[24.946,25.606],[25.646,25.686]]},{"key":"audience#2","text":"Health-conscious families","words":[[26.052,27.286],[27.339,27.766]]},{"key":"audience#3","text":"Snacks that balance familiar taste with ingredient preferences.","words":[[28.513,29.126],[29.158,29.286],[29.336,29.686],[29.73,30.086],[30.166,30.566],[30.614,30.806],[30.85,31.286],[31.339,32.006]]},{"key":"audience#4","text":"Position products as options for family snacking, supported by clear ingredient information.","words":[[32.13,33.126],[33.179,33.606],[33.633,33.686],[33.756,34.246],[34.266,34.326],[34.383,34.726],[34.806,35.446],[35.494,35.926],[35.979,36.086],[36.153,36.486],[36.537,37.046],[37.106,37.766]]},{"key":"audience#5","text":"Working professionals","words":[[37.896,38.806],[38.857,39.526]]},{"key":"audience#6","text":"Convenient snacks for work breaks and busy schedules.","words":[[40.181,40.726],[40.795,41.206],[41.246,41.366],[41.414,41.606],[41.675,42.086],[42.106,42.166],[42.23,42.486],[42.542,43.286]]},{"key":"audience#7","text":"Highlight convenience, taste, and suitable pack sizes.","words":[[43.582,44.086],[44.139,44.806],[44.899,45.606],[45.646,45.766],[45.81,46.166],[46.214,46.406],[46.499,47.166]]},{"key":"audience#8","text":"Festive gift buyers","words":[[47.478,48.086],[48.15,48.406],[48.475,48.886]]},{"key":"audience#9","text":"Gifts that feel thoughtful, attractive, and different from conventional sweets.","words":[[49.539,50.006],[50.038,50.166],[50.214,50.406],[50.457,51.126],[51.177,51.846],[51.886,52.006],[52.038,52.326],[52.374,52.566],[52.609,53.126],[53.195,53.686]]},{"key":"audience#10","text":"Showcase gift boxes, packaging, product variety, and gifting occasions.","words":[[54.335,55.046],[55.094,55.286],[55.379,56.206],[56.242,56.806],[56.846,57.126],[57.196,57.926],[57.946,58.006],[58.086,58.406],[58.47,59.166]]},{"key":"audience#11","text":"Corporate buyers","words":[[59.374,60.166],[60.235,60.646]]},{"key":"audience#12","text":"Bulk gifts for employees, clients, and business partners like JP Morgan, EY etc.","words":[[61.318,61.766],[61.833,62.166],[62.206,62.326],[62.39,63.126],[63.186,63.766],[63.786,63.846],[63.89,64.246],[64.299,64.726],[64.774,64.966],[65.099,65.366],[65.423,66.006],[66.166,66.566],[66.666,67.206]]},{"key":"audience#13","text":"Emphasise bulk-order options, presentation, customisation , and reliable fulfilment where available.","words":[[67.686,68.646],[68.71,69.206],[69.266,69.846],[69.908,70.886],[70.932,71.686],[71.846,72.006],[72.026,72.086],[72.148,72.646],[72.692,73.286],[73.326,73.526],[73.582,74.166]]},{"key":"audience#explain","text":"In simple words: A target audience is the group a brand wants to reach. Eat Better speaks to health-conscious families, working professionals, festive gift buyers and corporate buyers.","words":[[74.913,74.966],[75.023,75.366],[75.433,75.966],[76.066,76.166],[76.235,76.646],[76.69,77.046],[77.126,77.286],[77.306,77.366],[77.419,77.686],[77.726,77.766],[77.833,78.166],[78.219,78.486],[78.513,78.566],[78.633,78.966],[79.226,80.006],[80.063,80.406],[80.452,80.726],[80.779,80.886],[80.92,81.526],[81.579,82.326],[82.366,82.646],[82.692,83.686],[83.746,84.166],[84.214,84.406],[84.475,84.886],[84.946,85.126],[85.166,85.526],[85.595,86.086]]},{"key":"usp#0","text":"A reason to choose it","words":[[86.606,86.886],[86.932,87.206],[87.259,87.366],[87.4,87.606],[87.686,87.846]]},{"key":"usp#1","text":"A Unique Selling Proposition (USP) explains what makes a product or brand distinctive and gives customers a reason to choose it.","words":[[88.506,88.726],[88.783,89.126],[89.176,89.526],[89.586,90.246],[90.446,91.526],[91.588,92.086],[92.134,92.326],[92.366,92.566],[92.606,92.646],[92.706,93.126],[93.153,93.206],[93.273,93.606],[93.659,94.246],[94.346,94.646],[94.686,94.886],[94.942,95.446],[95.526,95.606],[95.652,95.926],[95.953,96.006],[96.052,96.326],[96.379,96.606]]},{"key":"usp#2","text":"Eat Better’s proposed value proposition centres on familiar snack experiences combined with specific ingredient and quality standards.","words":[[96.926,97.526],[97.56,97.926],[97.97,98.326],[98.393,98.726],[98.779,99.366],[99.436,99.926],[99.979,100.086],[100.139,100.566],[100.633,100.966],[101.039,101.846],[101.917,102.486],[102.518,102.646],[102.708,103.206],[103.257,103.766],[103.806,103.926],[103.976,104.326],[104.39,105.086]]},{"key":"usp#3","text":"These claims should be verified against the relevant product labels and official brand information, as formulations and claims may vary across products.","words":[[105.326,105.926],[105.983,106.326],[106.36,106.566],[106.619,106.726],[106.779,107.206],[107.246,107.526],[107.546,107.606],[107.65,108.006],[108.056,108.406],[108.475,108.886],[108.926,109.046],[109.09,109.446],[109.499,109.766],[109.819,110.726],[110.806,110.966],[111.015,111.606],[111.646,111.766],[111.823,112.166],[112.226,112.406],[112.47,112.726],[112.772,113.046],[113.108,113.806]]},{"key":"usp#4","text":"Example Instead of communicating only that a snack is tasty, a brand can explain what makes its product different in terms of ingredients, quality checks, and customer experience.","words":[[114.086,114.646],[114.776,115.686],[115.739,115.846],[115.897,116.566],[116.614,116.806],[116.838,116.966],[117.006,117.046],[117.113,117.446],[117.473,117.526],[117.619,118.486],[118.566,118.646],[118.713,119.046],[119.066,119.126],[119.186,119.606],[119.67,119.926],[119.979,120.246],[120.266,120.326],[120.386,120.806],[120.854,121.286],[121.339,121.446],[121.499,121.766],[121.793,121.846],[121.899,122.726],[122.776,123.126],[123.183,123.766],[123.806,123.926],[123.979,124.406],[124.471,125.127]]},{"key":"usp#5","text":"1 Specific Says exactly what is different.","words":[[126.006,126.326],[126.45,127.446],[127.654,128.486],[128.586,129.286],[129.318,129.446],[129.499,129.606],[129.646,130.086]]},{"key":"usp#6","text":"2 Relevant Matters to the customers you want.","words":[[130.886,131.206],[131.304,132.086],[132.196,132.966],[133.019,133.126],[133.146,133.206],[133.262,133.766],[133.786,133.846],[133.926,134.326]]},{"key":"usp#7","text":"3 Distinctive Competitors can’t say the same thing.","words":[[135.046,135.446],[135.606,136.646],[136.783,137.846],[137.926,138.246],[138.286,138.406],[138.426,138.486],[138.55,138.806],[138.859,139.206]]},{"key":"usp#8","text":"4 Supported by evidence Backed by labels, checks and facts.","words":[[140.006,140.326],[140.414,141.206],[141.259,141.366],[141.464,142.246],[142.326,142.726],[142.779,142.886],[142.966,143.726],[143.766,144.006],[144.066,144.246],[144.339,144.926]]},{"key":"usp#9","text":"Key concept A strong USP should be specific, relevant to customers, distinctive from competitors, and supported by evidence.","words":[[145.226,145.766],[145.846,146.406],[146.726,147.046],[147.115,147.526],[147.659,148.166],[148.2,148.406],[148.459,148.566],[148.637,149.566],[149.606,149.926],[149.953,150.006],[150.07,151.046],[151.079,151.446],[151.478,151.606],[151.659,152.566],[152.606,152.726],[152.782,153.286],[153.313,153.366],[153.428,154.046]]},{"key":"usp#explain","text":"Think of it like this: A unique selling proposition is the reason to choose a brand. A strong one is specific, relevant, different from competitors, and backed by evidence.","words":[[154.739,154.806],[154.833,154.886],[154.913,154.966],[155.014,155.206],[155.27,156.166],[156.206,156.246],[156.315,156.726],[156.766,157.046],[157.099,157.686],[157.766,157.926],[157.966,158.086],[158.132,158.406],[158.459,158.566],[158.612,158.886],[158.926,158.966],[159.033,159.446],[159.846,160.246],[160.303,160.646],[160.706,160.886],[160.913,160.966],[161.037,161.846],[161.89,162.566],[162.606,162.966],[162.998,163.126],[163.179,164.006],[164.046,164.166],[164.212,164.486],[164.539,164.646],[164.708,165.526]]},{"key":"persona#0","text":"Meet a typical customer","words":[[165.91,166.166],[166.246,166.326],[166.376,166.726],[166.788,167.286]]},{"key":"persona#1","text":"A customer persona is a simple profile representing a typical customer within a target audience .","words":[[167.946,168.166],[168.219,168.646],[168.716,169.206],[169.259,169.366],[169.446,169.526],[169.572,169.846],[169.916,170.406],[170.449,170.966],[171.046,171.126],[171.176,171.526],[171.588,172.086],[172.132,172.406],[172.486,172.566],[172.612,172.886],[172.948,173.446],[173.506,173.566]]},{"key":"persona#2","text":"A working parent shopping for family snacks.","words":[[174.006,174.326],[174.376,174.726],[174.783,175.126],[175.17,175.526],[175.566,175.686],[175.743,176.086],[176.155,176.646]]},{"key":"persona#3","text":"Products that combine enjoyable taste with ingredient choices that suit the family.","words":[[176.913,177.766],[177.782,177.846],[177.916,178.406],[178.462,178.966],[179.046,179.446],[179.494,179.686],[179.73,180.166],[180.226,180.646],[180.694,180.886],[180.95,181.206],[181.226,181.286],[181.355,181.886]]},{"key":"persona#4","text":"“Your favourite snacking moments, with ingredients you can understand.”","words":[[182.206,182.486],[182.526,182.886],[182.966,183.446],[183.496,184.006],[184.038,184.166],[184.213,184.726],[184.766,184.886],[184.926,185.046],[185.111,185.767]]},{"key":"persona#5","text":"Illustrative persona for classroom learning, not verified Eat Better customer research.","words":[[186.106,187.046],[187.106,187.526],[187.566,187.686],[187.742,188.246],[188.29,188.647],[188.786,189.206],[189.268,189.766],[189.846,190.086],[190.12,190.326],[190.379,190.806],[190.868,191.686]]},{"key":"persona#explain","text":"So what does that mean? A customer persona is a simple profile of a typical customer: who they are, what they need, and what makes them buy.","words":[[192.113,192.166],[192.214,192.406],[192.438,192.566],[192.598,192.726],[192.79,193.126],[193.526,193.926],[193.97,194.326],[194.406,194.966],[195.019,195.126],[195.206,195.286],[195.332,195.606],[195.676,196.166],[196.219,196.326],[196.366,196.406],[196.456,196.806],[196.868,197.926],[197.966,198.086],[198.134,198.326],[198.386,198.806],[198.854,199.046],[199.062,199.126],[199.206,199.846],[199.866,199.926],[199.974,200.166],[200.206,200.406],[200.454,200.646],[200.726,201.206]]},{"key":"activities#0","text":"Put it into practice","words":[[201.506,201.686],[201.713,201.766],[201.814,202.006],[202.068,202.566]]},{"key":"activities#1","text":"Three hands-on tasks. Each one only moves forward when your evidence is right — there is no way to guess past a step.","words":[[203.173,203.606],[203.673,204.246],[204.339,205.246],[205.334,205.686],[205.766,206.006],[206.07,206.326],[206.366,206.566],[206.636,207.126],[207.158,207.286],[207.318,207.446],[207.49,207.846],[207.899,208.006],[208.059,208.326],[208.566,208.806],[208.833,208.966],[209.019,209.126],[209.206,209.366],[209.426,209.606],[209.633,209.686],[209.753,210.086],[210.15,210.406],[210.486,210.566],[210.63,210.966]]},{"key":"activities#explain","text":"Let me explain: In the activities, you map where brands stand, check claims with evidence, and build a persona from real interviews.","words":[[211.74,211.77],[211.823,211.93],[212,212.81],[212.917,213.13],[213.17,213.29],[213.348,214.17],[214.21,214.33],[214.41,214.65],[214.677,214.81],[214.867,215.21],[215.277,216.01],[216.05,216.25],[216.296,216.57],[216.602,216.73],[216.783,217.45],[217.49,217.61],[217.65,217.85],[217.89,217.93],[218,218.49],[218.538,218.73],[218.794,219.05],[219.101,219.69]]},{"key":"outro","text":"And that's the whole chapter! You listened all the way through. Great job!","words":[[220.386,220.416],[220.448,220.736],[220.756,220.816],[220.843,220.976],[221.046,221.537],[221.696,222.176],[222.212,222.496],[222.556,222.736],[222.776,222.896],[222.936,223.056],[223.106,223.776],[223.829,224.096],[224.196,224.656]]}]}]}